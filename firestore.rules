rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isAuthenticated() && request.auth.token.email == 'ermikeab@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'ADMIN' || getUserData().role == 'Admin (HQ)')
      );
    }

    function isManagerOrAdmin() {
      return isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'MANAGER' || getUserData().role == 'Branch Manager')
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document for verifying Firestore client connectivity
    match /test/connection {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Branches & Fiscal Year Setup (Creation, modification, and deletion restricted to Admin only)
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Employees Directory (Creation, modification, and deletion restricted to Admin only)
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // KPI Categories (System and Custom - Creation, modification, and deletion restricted to Admin only)
    match /kpiCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Annual Plan Objectives (Creation, modification, and deletion restricted to Admin only)
    match /annualPlanObjectives/{objectiveId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Individual Staff KPIs
    match /kpis/{kpiId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actual', 'selfRating', 'managerRating'])
      );
    }

    // Periodic Plans
    match /periodicPlans/{planId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['annualActual', 'quarterly', 'monthly'])
      );
    }

    // Backlog Plans & Arrears
    match /backlogPlans/{backlogId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['backlogActual', 'status'])
      );
    }

    // Employee Plan & Backlog Assignments
    match /employeePlans/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['annualActual', 'quarterly', 'monthly'])
      );
    }

    // Performance Submissions (Employees can submit performance, Admin can approve/reject)
    match /performanceSubmissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
